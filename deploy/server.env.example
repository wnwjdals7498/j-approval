# Copy outside the checkout; do not put real credentials in Git.
JAP_TENANT=__PLACEHOLDER_TENANT__
KC_PUBLIC_URL=https://auth.jgw.test
JAP_PORT=54242
JAP_DB_HOST=127.0.0.1
JAP_DB_PORT=54236
JAP_DB_NAME=jgw_approval
JAP_DB_USER=jgw_approval
JAP_DB_PASSWORD=__PLACEHOLDER_DATABASE_PASSWORD__
JAP_TLS_CERTIFICATE=/external/runtime/tls/approval.crt
JAP_TLS_KEY=/external/runtime/tls/approval.key
NODE_EXTRA_CA_CERTS=/external/runtime/tls/keycloak-ca.crt
